; Скопируйте: cp config.ini.example config.ini
;
; Pyrogram-сессия — это строка в [bank] session, не патч библиотеки.
; Первый вход по телефону: python main.py (бот сам спросит api_id, телефон, код).
; Без телефона: вставьте готовую session ИЛИ
;   python scripts/login_bank.py --from путь/к/selfbot

[bot]
token =
admin_ids =
support_username = support
support_chat =
; Канал объявлений: @name или -100id. Бот должен быть админом с правом писать.
deals_channel =
; Картинки экранов: assets/menu.jpg, profile.jpg, deal.jpg… См. assets/README.txt
assets = assets
commission_percent = 2
currency = USDT
min_deposit = 5
min_withdraw = 10

[bank]
api_id =
api_hash =
session =
username =
; Сколько ★ списывает Telegram за передачу уникального подарка (обычно 25).
transfer_stars = 25
; Если баланс ниже — алерт админам. Держите запас: ожидающие NFT × transfer_stars.
min_stars = 50

[ton]
address =
api_key =
rate = 0
mnemonic =
network = mainnet
gas = 0.05
min_deal = 0.1
min_rub = 1
min_deposit = 0.1
min_withdraw = 0.1
usdt_master = EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

[fragment]
; Отдельный кошелёк (не [ton] mnemonic) для автопокупки Stars за TON на банковский аккаунт.
; Если Stars не хватает на передачу NFT — покупает pack из stars=100.
mnemonic =
; Ключ tonconsole.com (tonapi) или toncenter. Пустой — берётся [ton] api_key.
api_key =
; Cookies Fragment: JSON или stel_ssid=...; stel_dt=...; stel_token=...; stel_ton_token=...
; Пустые cookies + mnemonic + консоль: python main.py сам логинит Fragment (телефон или QR).
cookies =
wallet = V4R2
stars = 100
; toncenter или tonapi
provider = toncenter

[db]
path = data/garant.db
